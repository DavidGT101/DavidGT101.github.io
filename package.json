{
  "name": "rear-light-bar-simulator",
  "version": "0.1.0",
  "description": "High-fidelity automotive rear light bar simulator featuring manufacturer-specific animations",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "dev": "node launch.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "taillight",
    "lightbar",
    "automotive",
    "simulator",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.taillightsim.app",
    "productName": "Rear Light Bar Simulator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "TaillightSim.html",
      "TaillightSim.css",
      "TaillightSim.js",
      "audio/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  }
}
